http {
    server {
        listen 127.0.0.1:3490;

        root ./servers/server1;

        location / {
            index index.html
        }

        location /cgi {
            root ./servers/server1/cgi;
        }

        location /uploads {
            root ./servers/server1/uploads;
        }

        location /data {
            root ./servers/server1/uploads/data;
        }
    }

    server {
        listen 127.0.0.2:8080;
        
        root ./servers/server2;

        location / {
            root ./servers/server2;
        }

        location /data {
            root ./servers/server2/data;
        }

        location /uploads {
            root ./servers/server3/uploads;
        }
    }

    server {
        listen 127.0.0.4:3490;

        location / {
            root ./servers/server3;
        }

        location /data {
            root ./servers/server3/data;
        }

        location /uploads {
            root /servers/server3/uploads;
        }
    }
}