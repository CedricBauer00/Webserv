http {
    num_req_expected 100;
    root /home;
    server {
        listen 0.0.0.0:3491;
        server_name example.com;
        root ./servers/server1;
        index html;

        location / {
            root ./servers/server1;
            index index.html;
            allow GET DELETE;
        }

        location /get {
            root ./servers/server1;
            index get_page.html;
        }

        location /post {
            root ./servers/server1;
            index post_page.html;
        }

        location /delete {
            root ./servers/server1;
            index delete_page.html;
        }

        location /cgi {
            root ./servers/server1;
        }

        location /uploads {
            root ./servers/server1;
            autoindex on;
        }

        location /data {
            root ./servers/server1;
            autoindex on;
        }
    }

    server {
        listen 0.0.0.0:8080;
        root ./servers/server2;

        location / {
            root ./servers/server2;
            index index.html;
        }

        location /get {
            root ./servers/server2;
            index get_page.html;
        }

        location /post {
            root ./servers/server2;
            index post_page.html;
        }

        location /delete {
            root ./servers/server2;
            index delete_page.html;
        }

        location /data {
            root ./servers/server2;
            index file1.html;
        }

        location /uploads/data {
            root ./servers/server2;
            index index1.html;
        }
    }

    server {
        listen 0.0.0.0:3491 default_server;
        listen 0.0.0.0:8080;
        server_name webserv42.com;
        client_max_body_size 2000;

        location / {
            root ./servers/server3;
            index index.html;
        }

        location /get {
            root ./servers/server3;
            index get_page.html;
        }

        location /post {
            root ./servers/server3;
            index post_page.html;
        }

        location /delete {
            root ./servers/server3;
            index delete_page.html;
        }

        location /data {
            root ./servers/server3;
            index .html;
            autoindex on;
        }

        location /uploads {
            allow GET DELETE;
            root ./servers/server3;
            error_page 302 /error.html;
            error_page 404 =301 /delete/delete_page.html;
        }
    }

}