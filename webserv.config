http {
    server {
        listen 127.0.0.1:3490;

        root ./servers/server1;

        location /cgi {
            root ./servers/server1/cgi;
        }

        location /uploads {
            root ./servers/server1/uploads;
        }

        location /data {
            root ./servers/server1/uploads/data;
        }
    }

    server {
        listen 8080;

        location / {
            root /var/www;
        }
    }
    server {
        listen 3490;

        location /images {
            root /var/www;
        }
    }
}